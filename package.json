{
  "name": "multitable",
  "version": "0.9.0",
  "description": "The local-first AI agent framework and meta-harness for all your coding agents.",
  "keywords": [
    "agent",
    "agent-framework",
    "meta-harness",
    "claude",
    "codex",
    "grok",
    "coding",
    "cli"
  ],
  "homepage": "https://multitable.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/erickalfaro/multitable.git"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n daemon,web -c blue,magenta \"npm run dev -w @multitable/daemon\" \"npm run dev -w @multitable/web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.28.0"
  }
}
